#!/bin/bash
# Runs inside the maintainer sandbox: keeps the Hermes gateway running so the scheduled review digest is posted to Slack
# without the chat being open. Cron lives in the gateway, and the gateway only starts when you chose the digest
# (the launcher stored SLACK_HOME_CHANNEL, SLACK_DIGEST_TIME and SLACK_DIGEST_TZ in the profile's .env and attached the
# Slack provider). Started by kyverno-main, and by the launcher when you add the digest to a sandbox that already runs.
# One copy at a time; a second one exits. With --restart it replaces the running copy (the launcher does that when the
# gateway was started without the Slack token, for example because the provider was attached after the sandbox began).
set -u

export HERMES_HOME=/opt/hermes-home/.hermes
export PATH="/opt/hermes-home/.local/bin:$PATH"
PROFILE=maintainer
# The digest makes several GitHub calls; Hermes' default of 10 minutes without activity is tight on a slow connection.
export HERMES_CRON_TIMEOUT=1800
ENV_FILE="$HERMES_HOME/profiles/$PROFILE/.env"
JOB=review-digest

if [ "${1:-}" = --restart ]; then
  [ -f /tmp/kyverno-digest.pid ] && kill "$(cat /tmp/kyverno-digest.pid)" 2>/dev/null
  pkill -f "gateway run" 2>/dev/null
  WAIT=-w10
else
  WAIT=-n
fi
exec 9> /tmp/kyverno-digest.lock
flock "$WAIT" 9 || exit 0
echo $$ > /tmp/kyverno-digest.pid

env_get() { grep -E "^$1=" "$ENV_FILE" 2>/dev/null | head -n 1 | cut -d= -f2-; }

while true; do
  # Wait for the first-run setup (kyverno-start) and for the choices the launcher stores. The token is a placeholder
  # in the environment: the proxy swaps in the real one on requests to slack.com.
  CHANNEL="$(env_get SLACK_HOME_CHANNEL)"; TIME="$(env_get SLACK_DIGEST_TIME)"; TZ_NAME="$(env_get SLACK_DIGEST_TZ)"
  if [ -f "$HERMES_HOME/profiles/$PROFILE/.kyverno-user-setup" ] && [ -n "${SLACK_BOT_TOKEN:-}" ] && [ -n "$CHANNEL" ] && [[ "$TIME" =~ ^([01][0-9]|2[0-3]):[0-5][0-9]$ ]]; then
    # The job ships paused. Set when and where, then turn it on; running this again changes nothing it already has.
    # Cron reads the time in the profile's time zone.
    hermes -p "$PROFILE" config set timezone "${TZ_NAME:-UTC}" >/dev/null 2>&1
    hermes -p "$PROFILE" cron edit "$JOB" --schedule "${TIME#*:} ${TIME%:*} * * 1-5" --deliver "slack:$CHANNEL" >/dev/null 2>&1
    hermes -p "$PROFILE" cron resume "$JOB" >/dev/null 2>&1
    # No model key is exported here: each run loads the profile's .env itself. Hermes' pre-run check (which looks before
    # that load) is off in the profile's config, see container/setup-profile.sh.
    hermes gateway run
  fi
  sleep 10
done
