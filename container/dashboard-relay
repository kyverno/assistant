#!/usr/bin/python3 -I
"""Forward one TCP port to the Hermes dashboard, which listens on 127.0.0.1 inside the container.

Used only without OpenShell (container/kyverno --no-openshell). Docker can publish a port only if something listens on
the container's own address, but Hermes refuses a dashboard on a non-loopback address unless an auth provider is set up.
So the dashboard stays on loopback and this relay is the only thing on the container's address. The launcher publishes
it on 127.0.0.1 of your machine, on a network of its own that no other container joins.

usage: dashboard-relay LISTEN_PORT TARGET_PORT
"""
import asyncio
import sys


async def pipe(reader, writer):
    try:
        while data := await reader.read(65536):
            writer.write(data)
            await writer.drain()
    except (ConnectionError, asyncio.CancelledError):
        pass
    finally:
        writer.close()


async def handle(client_reader, client_writer, target_port):
    try:
        target_reader, target_writer = await asyncio.open_connection("127.0.0.1", target_port)
    except OSError:
        client_writer.close()
        return
    await asyncio.gather(pipe(client_reader, target_writer), pipe(target_reader, client_writer))


async def main(listen_port, target_port):
    server = await asyncio.start_server(lambda r, w: handle(r, w, target_port), "0.0.0.0", listen_port)
    async with server:
        await server.serve_forever()


if __name__ == "__main__":
    asyncio.run(main(int(sys.argv[1]), int(sys.argv[2])))
