#!/bin/bash
# Run the Kyverno assistant in plain Docker, without OpenShell. You normally start it as:
#
#   container/kyverno --no-openshell [options]
#
# OpenShell is the default and the safer way to run the assistant (see docs/container.md). This is the opt-in for
# people who do not want OpenShell: the same image, run as one Docker container. What that gives up:
#   - no proxy: the agent holds your real GitHub token and API keys (in its environment), not placeholders;
#   - no network allowlist: the container can reach the whole internet;
#   - nothing blocks merges except the token's own scopes (use a fine-grained token, README step 1);
#   - no audit log of what it contacted.
# What it keeps: a non-root user, no Linux capabilities, no-new-privileges, a process limit, no host mounts, and the
# terminal and file tools blocked (add --allow-terminal to turn them on; the container is then the only boundary).
#
#   --build           build the image from this checkout (container/Dockerfile) instead of pulling one
#   --image IMAGE     use this image (default: $KYVERNO_IMAGE, else ghcr.io/kyverno/assistant:latest)
#   --name NAME       container name (default: kyverno-assistant-docker)
#   --provider P      also use model provider P (anthropic, openai or nvidia): its API key is asked once and kept in
#                     the secrets file. Without it, the assistant uses GitHub Copilot.
#   --upgrade         recreate the container from the (new) image and keep your state: memory, chat history, repo
#                     and username, Copilot sign-in and model choice. Use it with --build or --image.
#   --allow-terminal  let the agent use the terminal and file tools inside the container (blocked by default)
#   --yes             do not ask for confirmation when the container is created
#   --no-attach       set everything up but do not open the chat
#   --reset           forget the stored GitHub token and ask for it again
#
# Secrets file: ${KYVERNO_SECRETS_FILE:-~/.config/kyverno-assistant/secrets.env}, mode 600, KEY=value lines. The
# launcher copies it into a tmpfs inside the container on every start (so the keys are never in the image, in
# `docker inspect`, or on the container's disk) and the agent reads them from there.
set -uo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$HERE/.." && pwd)"
IMAGE="${KYVERNO_IMAGE:-ghcr.io/kyverno/assistant:latest}"
NAME="kyverno-assistant-docker"
SECRETS_FILE="${KYVERNO_SECRETS_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/kyverno-assistant/secrets.env}"
BUILD=0
RESET=0
UPGRADE=0
NO_ATTACH=0
ALLOW_TERMINAL=0
ASSUME_YES=0
BACKUP_DIR=""
WANT_PROVIDERS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --no-openshell) shift ;;
    --build) BUILD=1; shift ;;
    --image) IMAGE="${2:-}"; shift 2 ;;
    --name) NAME="${2:-}"; shift 2 ;;
    --provider) WANT_PROVIDERS+=("${2:-}"); shift 2 ;;
    --upgrade) UPGRADE=1; shift ;;
    --allow-terminal) ALLOW_TERMINAL=1; shift ;;
    --yes) ASSUME_YES=1; shift ;;
    --no-attach) NO_ATTACH=1; shift ;;
    --reset) RESET=1; shift ;;
    -h|--help) sed -n '2,29p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "unknown option: $1 (see --help)" >&2; exit 2 ;;
  esac
done

pass() { printf '  \033[32m✓\033[0m %s\n' "$1"; }
fail() { printf '  \033[31m✗\033[0m %s\n' "$1" >&2; }
info() { printf '  %s\n' "$1"; }
step() { printf '\n\033[1m%s\033[0m\n' "$1"; }
# gh's own sign-in only: a GH_TOKEN or GITHUB_TOKEN in the environment is not what we mean to store.
gh_token() { env -u GH_TOKEN -u GITHUB_TOKEN gh auth token --hostname github.com 2>/dev/null; }

# --- the secrets file on this machine ---
secrets_get() {
  [ -f "$SECRETS_FILE" ] || return 0
  sed -n "s/^$1=//p" "$SECRETS_FILE" | head -n 1
}
secrets_set() {
  local key="$1" value="$2" dir tmp
  dir="$(dirname "$SECRETS_FILE")"
  # umask 077: a directory this creates is 700 and the file is 600. An existing directory is left as it is.
  ( umask 077; mkdir -p "$dir" ) || return 1
  tmp="$(umask 077; mktemp "$SECRETS_FILE.XXXXXX")" || return 1
  { [ -f "$SECRETS_FILE" ] && grep -v "^$key=" "$SECRETS_FILE"; printf '%s=%s\n' "$key" "$value"; } > "$tmp"
  mv "$tmp" "$SECRETS_FILE" && chmod 600 "$SECRETS_FILE"
}
secrets_unset() {
  local key="$1" tmp
  [ -f "$SECRETS_FILE" ] || return 0
  tmp="$(umask 077; mktemp "$SECRETS_FILE.XXXXXX")" || return 1
  grep -v "^$key=" "$SECRETS_FILE" > "$tmp"
  mv "$tmp" "$SECRETS_FILE" && chmod 600 "$SECRETS_FILE"
}

# --- the container ---
container_exists() { docker container inspect "$NAME" >/dev/null 2>&1; }
container_running() { [ "$(docker container inspect -f '{{.State.Running}}' "$NAME" 2>/dev/null)" = true ]; }

# Copy the allowed keys into the container's tmpfs (a pipe: nothing is written to the container's disk).
inject_secrets() {
  grep -E '^(REPO_GITHUB_TOKEN|ANTHROPIC_API_KEY|OPENAI_API_KEY|NVIDIA_API_KEY)=' "$SECRETS_FILE" \
    | docker exec -i "$NAME" sh -c 'umask 077; cat > /run/kyverno-secrets/env.tmp && mv /run/kyverno-secrets/env.tmp /run/kyverno-secrets/env'
}

# What is yours: memory, chat history, your repo and username, the Copilot sign-in, the model you chose.
# The profile itself (skills, hooks, plugins, settings) comes from the new image.
save_state() {
  local dest="$1"
  # The single quotes are deliberate: this runs inside the container, so nothing should expand here.
  # shellcheck disable=SC2016
  docker exec "$NAME" sh -c \
    'cd /opt/hermes-home/.hermes/profiles/kyverno && tar -cf - $(ls -d .env config.yaml .kyverno-model-chosen mnemosyne/data memories sessions kyverno-dashboard state.db state.db-wal state.db-shm 2>/dev/null)' \
    > "$dest/kyverno-state.tar" 2>/dev/null || return 1
  [ -s "$dest/kyverno-state.tar" ]
}
restore_state() {
  local src="$1"
  docker exec -i "$NAME" sh -c 'cat > /tmp/kyverno-state.tar' < "$src/kyverno-state.tar" || return 1
  docker exec -i "$NAME" sh -c 'cat > /tmp/restore-state.sh' < "$HERE/restore-state.sh" || return 1
  docker exec -e KYVERNO_STATE_TAR=/tmp/kyverno-state.tar "$NAME" bash /tmp/restore-state.sh
}

step "1. Docker"
if ! command -v docker >/dev/null 2>&1 || ! docker info >/dev/null 2>&1; then
  fail "Docker is not installed or not running — start Docker and re-run"
  exit 1
fi
pass "docker is running (no OpenShell: see the notes at the top of this file, or --help)"

step "2. Image"
if [ "$BUILD" = 1 ]; then
  IMAGE="kyverno-assistant:dev"
  info "building $IMAGE from this checkout (the first build takes several minutes)..."
  docker build -f "$REPO_ROOT/container/Dockerfile" -t "$IMAGE" "$REPO_ROOT" || { fail "image build failed"; exit 1; }
  if [ "$UPGRADE" != 1 ] && container_exists; then
    info "note: '$NAME' already exists and keeps running the image it was made from; add --upgrade to switch it to this build"
  fi
elif [ "$UPGRADE" = 1 ] || ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
  info "pulling $IMAGE..."
  if ! docker pull "$IMAGE"; then
    # An image that only exists on this machine (built with --build) cannot be pulled; that is fine.
    if docker image inspect "$IMAGE" >/dev/null 2>&1; then
      info "could not pull it; using the copy already on this machine"
    else
      fail "could not pull $IMAGE — use --build, or --image with an image you have"
      exit 1
    fi
  fi
fi
pass "image $IMAGE"

step "3. Keys"
info "secrets file: $SECRETS_FILE"
[ "$RESET" = 1 ] && secrets_unset REPO_GITHUB_TOKEN
REPO="${KYVERNO_REPO:-}"
LOGIN="${MAINTAINER_GITHUB_LOGIN:-}"
if [ -n "$(secrets_get REPO_GITHUB_TOKEN)" ]; then
  pass "GitHub token already in the secrets file (use --reset to replace it)"
else
  [ -z "$REPO" ] && read -r -p "  Repo to manage (owner/repo) [kyverno/kyverno]: " REPO
  REPO="${REPO:-kyverno/kyverno}"
  [[ "$REPO" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*/[A-Za-z0-9_.-]+$ && "${REPO#*/}" != "." && "${REPO#*/}" != ".." ]] || { fail "'$REPO' is not an owner/repo name (letters, digits, dots, dashes, underscores)"; exit 1; }
  PAT=""
  METHOD="paste"
  if command -v gh >/dev/null 2>&1; then
    info "How do you want to authorize GitHub?"
    info "  1) Sign in with GitHub (gh): a browser sign-in, nothing to create. gh always asks for the 'repo'"
    info "     scope, so the token can act on every repository you have access to, private ones included, not"
    info "     only $REPO. Without OpenShell the assistant holds this token itself, and nothing but the token's"
    info "     scopes stops it merging. Prefer option 2."
    info "  2) Paste a fine-grained token (README step 1): limited to the one repository you scope it to."
    CHOICE=""
    read -r -p "  Choose [2]: " CHOICE </dev/tty
    case "${CHOICE:-2}" in
      1) METHOD="gh" ;;
      2) ;;
      *) fail "'$CHOICE' is not 1 or 2"; exit 1 ;;
    esac
  else
    info "The GitHub CLI (gh) is not installed, so there is no browser sign-in (https://cli.github.com)."
  fi
  if [ "$METHOD" = gh ]; then
    PAT=$(gh_token) || PAT=""
    if [ -z "$PAT" ]; then
      info "gh is not signed in. Starting its browser sign-in..."
      env -u GH_TOKEN -u GITHUB_TOKEN gh auth login --hostname github.com --git-protocol https --web </dev/tty \
        || { fail "the gh sign-in did not finish (re-run, or choose 2 and paste a token)"; exit 1; }
      PAT=$(gh_token) || PAT=""
      [ -z "$PAT" ] && { fail "gh did not give a token after signing in"; exit 1; }
    else
      pass "using your existing gh sign-in"
    fi
  else
    info "Paste your fine-grained GitHub token (see README step 1). It is saved in the secrets file, mode 600."
    read -r -s -p "  GitHub token: " PAT </dev/tty
    echo
  fi
  [ -z "$PAT" ] && { fail "no token entered (this step needs a terminal to ask for it)"; exit 1; }
  # Check it before storing it. The token goes in through stdin, so it never shows in a process list.
  CODE=$(printf 'header = "Authorization: Bearer %s"\n' "$PAT" \
         | curl -s -o /dev/null -w '%{http_code}' -K - "https://api.github.com/repos/$REPO")
  case "$CODE" in
    200) pass "GitHub accepts the token for $REPO" ;;
    401) fail "GitHub rejected the token (401): wrong, expired or revoked"; exit 1 ;;
    403|404) fail "the token cannot read $REPO ($CODE): scope it to that repo, or get the org to approve it"; exit 1 ;;
    *) info "could not verify the token (HTTP ${CODE:-none}) — continuing" ;;
  esac
  if [ -z "$LOGIN" ]; then
    LOGIN=$(printf 'header = "Authorization: Bearer %s"\n' "$PAT" \
            | curl -s -m 10 -K - https://api.github.com/user | sed -n 's/.*"login": *"\([^"]*\)".*/\1/p' | head -n 1)
    if [[ "$LOGIN" =~ ^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?$ ]]; then pass "signed in to GitHub as $LOGIN"; else LOGIN=""; fi
  fi
  secrets_set REPO_GITHUB_TOKEN "$PAT" || { fail "could not write the secrets file"; exit 1; }
  unset PAT
  pass "token saved in the secrets file"
fi

for P in "${WANT_PROVIDERS[@]+"${WANT_PROVIDERS[@]}"}"; do
  case "$P" in
    anthropic) VAR=ANTHROPIC_API_KEY ;;
    openai) VAR=OPENAI_API_KEY ;;
    nvidia) VAR=NVIDIA_API_KEY ;;
    *) fail "unknown model provider '$P' (use anthropic, openai or nvidia)"; exit 1 ;;
  esac
  if [ -n "$(secrets_get "$VAR")" ]; then
    pass "$P key already in the secrets file"
  else
    KEY=""
    { read -r -s -p "  $P API key: " KEY </dev/tty; } 2>/dev/null
    echo
    [ -z "$KEY" ] && { fail "no $P key entered (this step needs a terminal to ask for it)"; exit 1; }
    secrets_set "$VAR" "$KEY" || { fail "could not write the secrets file"; exit 1; }
    unset KEY
    pass "$P key saved in the secrets file"
  fi
done

step "4. Container"
if [ "$UPGRADE" = 1 ] && container_exists; then
  container_running || docker start "$NAME" >/dev/null 2>&1
  BACKUP_DIR="$(mktemp -d)"; chmod 700 "$BACKUP_DIR"
  info "saving your state from '$NAME' before recreating it..."
  save_state "$BACKUP_DIR" || { fail "could not save the state, so the container was left alone"; rm -rf "$BACKUP_DIR"; exit 1; }
  pass "state saved"
  docker rm -f "$NAME" >/dev/null 2>&1
  container_exists && { fail "the old container did not go away; your state is saved in $BACKUP_DIR"; exit 1; }
fi
if container_exists; then
  WAS_TERMINAL="$(docker container inspect -f '{{index .Config.Labels "kyverno.allow-terminal"}}' "$NAME" 2>/dev/null)"
  if [ "${WAS_TERMINAL:-0}" != "$ALLOW_TERMINAL" ]; then
    info "note: '$NAME' was created with the terminal $([ "${WAS_TERMINAL:-0}" = 1 ] && echo allowed || echo blocked); add --upgrade to recreate it with your choice"
  fi
  container_running || { docker start "$NAME" >/dev/null || { fail "could not start '$NAME'"; exit 1; }; info "started '$NAME'"; }
else
  if [ "$ASSUME_YES" != 1 ]; then
    info "You are about to run the assistant WITHOUT OpenShell:"
    info "  - the container is the only boundary: the agent holds your real GitHub token and API keys"
    info "  - there is no network allowlist: it can reach the whole internet"
    info "  - nothing blocks merges except the GitHub token's own scopes"
    if [ "$ALLOW_TERMINAL" = 1 ]; then
      info "  - the terminal and file tools are ENABLED inside the container (--allow-terminal)"
    else
      info "  - the terminal and file tools are blocked (--allow-terminal turns them on)"
    fi
    ANSWER=""
    read -r -p "  Continue? [y/N] " ANSWER </dev/tty || ANSWER=""
    case "$ANSWER" in y|Y|yes|YES) ;; *) fail "not continuing (use --yes to skip this question)"; exit 1 ;; esac
  fi
  ENV_ARGS=(-e KYVERNO_RUNTIME=docker)
  [ "$ALLOW_TERMINAL" = 1 ] && ENV_ARGS+=(-e KYVERNO_ALLOW_TERMINAL=1)
  info "creating '$NAME'..."
  # --init: Hermes wants an init process above it to reap children. The keys go in through a tmpfs (mode 700, uid
  # 1000), which is empty again each time the container stops. Nothing from this machine is mounted.
  docker run -d --init --name "$NAME" \
    --cap-drop ALL --security-opt no-new-privileges --pids-limit 1024 \
    --tmpfs /run/kyverno-secrets:rw,noexec,nosuid,nodev,size=1m,mode=0700,uid=1000,gid=1000 \
    --tmpfs /tmp:rw,exec,nosuid,nodev,size=1g,mode=1777 \
    --label "kyverno.allow-terminal=$ALLOW_TERMINAL" \
    "${ENV_ARGS[@]}" "$IMAGE" kyverno-main >/dev/null \
    || { fail "could not create the container"; exit 1; }
fi
for _ in $(seq 1 30); do container_running && break; sleep 1; done
container_running || { fail "container '$NAME' is not running — see: docker logs $NAME"; exit 1; }
inject_secrets || { fail "could not copy the keys into the container"; exit 1; }
pass "container '$NAME' is running; keys copied in memory only"

if [ -n "$BACKUP_DIR" ]; then
  info "restoring your state..."
  if restore_state "$BACKUP_DIR"; then
    rm -rf "$BACKUP_DIR"; pass "state restored"
  else
    fail "could not restore the state; the saved copy is still in $BACKUP_DIR (it holds your Copilot token: delete it when done)"
    exit 1
  fi
fi

step "5. Assistant"
ARGS=()
[ -n "$REPO" ] && ARGS+=(--repo "$REPO")
[ -n "$LOGIN" ] && ARGS+=(--login "$LOGIN")
[ "$NO_ATTACH" = 1 ] && { pass "ready (not opening the chat: --no-attach)"; exit 0; }
exec docker exec -it "$NAME" kyverno-start "${ARGS[@]+"${ARGS[@]}"}"
