# Copy this file to .env in the installed profile directory and fill in real values.
# Never commit the filled-in .env.

# --- LLM provider (fill in ONE, or pick a provider with `hermes -p kyverno-contributor model`) ---
ANTHROPIC_API_KEY=
COPILOT_GITHUB_TOKEN=

# --- GitHub -------------------------------------------------------------------
# Fine-grained PAT of your own account. Public repositories (read-only) is enough to read everything;
# add Issues: Read and write on the upstream repo only if you want the assistant to comment on issues
# for you. No Contents write, no admin, no workflow scopes.
REPO_GITHUB_TOKEN=

# Your GitHub username.
CONTRIBUTOR_GITHUB_LOGIN=

# The repository you contribute to (owner/repo).
KYVERNO_REPO=kyverno/kyverno
